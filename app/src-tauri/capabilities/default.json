{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main settings window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-status",
    "allow-replay-menu-action",
    "allow-get-diagnostics",
    "allow-list-microphones",
    "allow-list-monitors",
    "allow-list-library",
    "allow-library-preview",
    "allow-library-action",
    "allow-hud-arrange",
    "allow-local-builds",
    "allow-install-local-build",
    "allow-check-update",
    "allow-install-update",
    "allow-encoder-check",
    "allow-setup-check",
    "allow-overload-status",
    "allow-lighter-video",
    "allow-nvidia-overlay-keys",
    "allow-crash-notice",
    "allow-crash-dismiss",
    "allow-crash-open-folder",
    "allow-open-logs-folder",
    "allow-about-open",
    "allow-pause-hotkeys",
    "allow-save-problem-report",
    "allow-ui-log",
    "allow-ui-heartbeat"
  ]
}
