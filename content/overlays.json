      { "id": "ChatPTTHKey", "key": "Alt+V", "does": "is NVIDIA's chat push-to-talk key" },
      { "id": "FSPresetHKey", "key": "Alt+Shift+X", "does": "switches NVIDIA's game filter" },
      { "id": "FSToggleHKey", "key": null, "does": "turns NVIDIA's game filters on and off" },
      { "id": "PMOCLoggingToggleHKey", "key": null, "does": "starts and stops NVIDIA's performance log" },
      { "id": "PMOCResetAverageMetricsHKey", "key": null, "does": "resets NVIDIA's performance averages" },
      { "id": "PMOCFontSizeCycleHKey", "key": null, "does": "changes the size of NVIDIA's performance overlay" }
